# URL base de redvida-server. Sin barra final.
VITE_API_URL=http://localhost:3000/v1

# Modo demostración del registro. Ausente o distinto de 1 = desactivado.
#
# Con VITE_DEMO=1 el wizard de /registro no valida y responde con datos de
# ejemplo, para poder enseñar las pantallas sin servidor. Se resuelve en
# COMPILACIÓN: no hay forma de encenderlo desde el navegador.
#
# Para el día a día póngalo en `.env.development.local`, nunca en `.env.local`:
# Vite carga `.env.local` también al compilar para producción.
# VITE_DEMO=1
