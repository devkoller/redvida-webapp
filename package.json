{
	"name": "redvida-webapp",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite --host",
		"a11y:preparar": "cp node_modules/axe-core/axe.min.js public/axe.min.js && echo 'axe disponible en /axe.min.js — recuerde borrarlo antes de compilar'",
		"a11y:limpiar": "rm -f public/axe.min.js",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"typecheck": "tsc -b --noEmit",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"engines": {
		"node": ">=24 <25"
	},
	"packageManager": "pnpm@10.13.1",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@swc/core",
			"esbuild"
		]
	},
	"dependencies": {
		"@hello-pangea/dnd": "^18.0.1",
		"@hookform/resolvers": "^5.1.1",
		"@radix-ui/react-accordion": "^1.2.12",
		"@radix-ui/react-checkbox": "^1.3.2",
		"@radix-ui/react-label": "^2.1.7",
		"@radix-ui/react-progress": "^1.1.7",
		"@radix-ui/react-radio-group": "^1.3.7",
		"@radix-ui/react-select": "^2.2.5",
		"@radix-ui/react-separator": "^1.1.7",
		"@radix-ui/react-slot": "^1.2.3",
		"@react-three/drei": "^10.7.8",
		"@react-three/fiber": "^9.7.0",
		"@tailwindcss/vite": "^4.1.10",
		"@tanstack/react-query": "^5.81.2",
		"@tanstack/react-router": "^1.121.34",
		"@tanstack/react-table": "^8.21.3",
		"axios": "^1.10.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"exceljs": "^4.4.0",
		"lucide-react": "^0.516.0",
		"next-themes": "^0.4.6",
		"quill": "^2.0.3",
		"radix-ui": "^1.6.7",
		"react": "^19.1.0",
		"react-day-picker": "9.7.0",
		"react-dom": "^19.1.0",
		"react-hook-form": "^7.58.1",
		"react-markdown": "^10.1.0",
		"sonner": "^2.0.5",
		"tailwind-merge": "^3.3.1",
		"tailwindcss": "^4.1.10",
		"three": "^0.185.1",
		"zod": "^3.25.67",
		"zustand": "^5.0.5"
	},
	"devDependencies": {
		"@tanstack/router-plugin": "^1.121.34",
		"@types/node": "^24.13.3",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@types/three": "^0.185.4",
		"@vitejs/plugin-react-swc": "^3.10.2",
		"axe-core": "^4.12.1",
		"prettier": "^3.6.0",
		"prettier-plugin-tailwindcss": "^0.6.13",
		"typescript": "^5.9.3",
		"vite": "^7.0.0"
	}
}
